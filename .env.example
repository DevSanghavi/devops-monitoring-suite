export PROFILE=""
export REGION=""
export EC2_INSTANCE_ID=""
export EC2_PUBLIC_IP=""
export EC2_SECURITY_GROUP_ID=""
export SSH_KEY_PATH=""
export EC2_AZ=""
export NGINX_CONTAINER_NAME=""
export NGINX_CONF_SOURCE=""
export IAM_INSTANCE_PROFILE_NAME=""
export ROLE_NAME=""
export DISK_DEVICE=""
export DISK_FSTYPE=""
export CPU_ALARM_NAME=""
export MEMORY_ALARM_NAME=""
export DISK_ALARM_NAME=""
export SNS_TOPIC_ARN=""
export ALERT_EMAIL=""
export BACKUP_BUCKET=""
export BACKUP_LOG_FILE=""
export DASHBOARD_URL=""
ssmrun() {
  local cid params
  params=$(python3 -c 'import json,sys;print(json.dumps({"commands":[sys.argv[1]]}))' "$1")
  cid=$(aws ssm send-command --profile "$PROFILE" --region "$REGION" --instance-ids "$EC2_INSTANCE_ID" \
    --document-name AWS-RunShellScript --parameters "$params" --query Command.CommandId --output text) || return 1
  sleep 2
  aws ssm wait command-executed --profile "$PROFILE" --region "$REGION" --command-id "$cid" --instance-id "$EC2_INSTANCE_ID" 2>/dev/null
  aws ssm get-command-invocation --profile "$PROFILE" --region "$REGION" --command-id "$cid" --instance-id "$EC2_INSTANCE_ID" --query StandardErrorContent --output text >&2
  aws ssm get-command-invocation --profile "$PROFILE" --region "$REGION" --command-id "$cid" --instance-id "$EC2_INSTANCE_ID" --query StandardOutputContent --output text
}
